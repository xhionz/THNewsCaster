# Copy to .env in this directory: cp .env.example .env  (then edit)

# --- Model ---------------------------------------------------------------
# Instruct (non-thinking) MoE: 80B total / ~3B active per token. Fast + great
# at structured JSON, which is exactly what THNewsCaster needs.
MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct-FP8

# --- Container image -----------------------------------------------------
# Default works if vllm/vllm-openai resolves an arm64 build on your Spark.
# If `docker compose up` errors with "no matching manifest for linux/arm64",
# switch to the NVIDIA NGC vLLM container (see README) and pin a tag here.
VLLM_IMAGE=vllm/vllm-openai:latest

# --- Networking ----------------------------------------------------------
# Host port THNewsCaster connects to: THNC_OPENAI_BASE_URL=http://<spark-ip>:8001/v1
VLLM_PORT=8001

# --- Resources / runtime -------------------------------------------------
# Context length. 32k is plenty for per-article hypothesis generation.
MAX_MODEL_LEN=32768
# Fraction of GPU memory vLLM may use. The Spark shares memory between CPU and
# GPU (unified), so start conservative and raise if it's stable.
GPU_MEM_UTIL=0.85

# Where weights are cached on the host (persists across container restarts).
HF_CACHE=./hf-cache

# --- Secrets -------------------------------------------------------------
# Hugging Face token (needed to pull the model the first time).
HUGGING_FACE_HUB_TOKEN=hf_replace_me
