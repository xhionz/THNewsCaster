# THNewsCaster daemon configuration.
# Copy to /etc/thnewscaster/thnewscaster.env and edit. The systemd unit reads
# this file. Lines are KEY=VALUE; no surrounding quotes needed.

# --- Custom OpenAI-compatible endpoint -------------------------------------
# Base URL must include the version path the server expects (usually /v1).
# Works with OpenAI, Azure OpenAI gateways, vLLM, Ollama (/v1), LM Studio, etc.
THNC_OPENAI_BASE_URL=https://your-endpoint.example/v1
THNC_OPENAI_API_KEY=sk-replace-me
THNC_OPENAI_MODEL=gpt-4o-mini
# Per-request timeout. Raise well above 60 for local/reasoning models.
# THNC_OPENAI_TIMEOUT=300
# THNC_OPENAI_MAX_TOKENS=4096
# THNC_OPENAI_TEMPERATURE=0.2
# For reasoning models (e.g. Qwen3 "Thinking" via vLLM): disable the slow,
# JSON-unfriendly chain-of-thought. Strongly recommended for this workload.
# THNC_OPENAI_DISABLE_THINKING=true

# Set to false to force the heuristic generator even when an endpoint is set.
# Default: enabled whenever THNC_OPENAI_BASE_URL is non-empty.
# THNC_LLM_ENABLED=true

# --- Output ----------------------------------------------------------------
THNC_OUT_DIR=/var/lib/thnewscaster/site
THNC_WRITE_HTML=true
THNC_WRITE_MARKDOWN=true

# --- Scoring / volume ------------------------------------------------------
# THNC_THRESHOLD=30
# Max NEW articles to generate hypotheses for per run (caps LLM calls).
# THNC_MAX_BRIEFINGS=25

# --- Dedup / archive / rolling window --------------------------------------
# Cross-run dedup: only run hypothesis generation on articles not seen before.
# THNC_DEDUP=true
# SQLite state file (defaults to <THNC_OUT_DIR>/../state.db).
# THNC_STATE_DB=/var/lib/thnewscaster/state.db
# Published site shows briefings first seen within this many days...
# THNC_RETENTION_DAYS=14
# ...capped at this many.
# THNC_SITE_MAX=50
# Write a dated snapshot under <out>/archive each run.
# THNC_ARCHIVE=true

# --- Exports ---------------------------------------------------------------
# IOC exports (iocs.csv / iocs.json / iocs_stix.json), grouped by type.
# THNC_WRITE_IOCS=true
# Write LLM-generated Sigma rules to <out>/sigma/*.yml.
# THNC_WRITE_SIGMA=true

# --- Notifications (optional) ----------------------------------------------
# Slack (or compatible) incoming webhook for new high-scoring briefings.
# THNC_SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz
# Only notify for briefings at/above this score.
# THNC_NOTIFY_MIN_SCORE=60
# Email via SMTP (all must be set to enable).
# THNC_SMTP_HOST=smtp.example.com
# THNC_SMTP_PORT=587
# THNC_SMTP_USER=alerts@example.com
# THNC_SMTP_PASSWORD=app-password
# THNC_SMTP_FROM=alerts@example.com
# THNC_SMTP_TO=soc@example.com

# Use the bundled sample feed instead of live network pulls (testing only).
# THNC_OFFLINE=false

# --- Publish to GitHub Pages -----------------------------------------------
# After each build the daemon pushes the rendered site to a branch; a deploy
# workflow on that branch publishes it to GitHub Pages. Leave THNC_PAGES_REPO
# unset to skip publishing (build-only).
#
# Use an SSH remote + a deploy key with write access (Repo -> Settings ->
# Deploy keys -> Add, "Allow write access"). Generate the key with:
#   sudo -u thnewscaster ssh-keygen -t ed25519 -f /etc/thnewscaster/pages_deploy_key -N ''
# then add the .pub contents as the deploy key.
THNC_PAGES_REPO=git@github.com:xhionz/thnewscaster.git
THNC_PAGES_BRANCH=gh-pages
THNC_PAGES_DOMAIN=thnews.wusaapp.net
THNC_PAGES_SSH_KEY=/etc/thnewscaster/pages_deploy_key
# THNC_GIT_NAME=THNewsCaster
# THNC_GIT_EMAIL=thnewscaster@localhost
