# THNewsCaster daemon configuration.
# Copy to /etc/thnewscaster/thnewscaster.env and edit. The systemd unit reads
# this file. Lines are KEY=VALUE; no surrounding quotes needed.

# --- Custom OpenAI-compatible endpoint -------------------------------------
# Base URL must include the version path the server expects (usually /v1).
# Works with OpenAI, Azure OpenAI gateways, vLLM, Ollama (/v1), LM Studio, etc.
THNC_OPENAI_BASE_URL=https://your-endpoint.example/v1
THNC_OPENAI_API_KEY=sk-replace-me
THNC_OPENAI_MODEL=gpt-4o-mini
# THNC_OPENAI_TIMEOUT=60
# THNC_OPENAI_MAX_TOKENS=4096
# THNC_OPENAI_TEMPERATURE=0.2

# Set to false to force the heuristic generator even when an endpoint is set.
# Default: enabled whenever THNC_OPENAI_BASE_URL is non-empty.
# THNC_LLM_ENABLED=true

# --- Output ----------------------------------------------------------------
THNC_OUT_DIR=/var/lib/thnewscaster/site
THNC_WRITE_HTML=true
THNC_WRITE_MARKDOWN=true

# --- Scoring / volume ------------------------------------------------------
# THNC_THRESHOLD=30
# THNC_MAX_BRIEFINGS=25

# Use the bundled sample feed instead of live network pulls (testing only).
# THNC_OFFLINE=false
